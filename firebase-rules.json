{
  "rules": {
    "rooms": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$roomCode": {
        ".read": "auth != null",
        ".write": "auth != null",
        "meta": {
          ".write": "auth != null"
        },
        "players": {
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null"
          }
        },
        "hostPassword": {
          ".read": false,
          ".write": "auth != null"
        },
        "gameConfig": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "gameState": {
          ".read": "auth != null",
          ".write": "auth != null",
          "currentVotes": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid"
            }
          },
          "missionVotes": {
            "$mission": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid"
              }
            }
          }
        }
      }
    }
  }
}
